{
  "name": "S5LuaDebuggerAdaptor",
  "displayName": "S5 LuaDebugger Adaptor",
  "version": "1.0.0",
  "publisher":"mcbANDschmeling65",
  "license": "MIT",
  "description": "The extension allows debugging S5 maps during runtime.",
  "categories": ["Other","Debuggers"],
  "type": "module",
  "engines": {
    "vscode": "^1.136.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mcb5637/S5DebugAdaptor"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "breakpoints": [
      {
        "language": "lua"
      }
    ],
    "debuggers": [
      {
        "type": "s5lua",
        "label": "S5 Lua Debug"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "S5LuaDebuggerSideBar",
          "title": "S5LuaDebugger Adaptor",
          "icon": "out/media/icon.svg"
        }
      ]
    },
    "views": {
      "S5LuaDebuggerSideBar": [
        {
          "type": "webview",
          "id": "S5LuaDebuggerAdaptor-toggle-view",
          "name": "Einstellungen"
        }
      ]
    },
    "commands": [
      {
        "command": "activateS5LuaDebuggerAdaptor",
        "title": "Activate S5LuaDebuggerAdaptor"
      }
    ],
    "initialConfigurations": [
      {
        "type": "s5lua",
        "request": "attach",
        "name": "Launch Program"
      }
    ]
  },
  "scripts": {
    "prestartpackagepipeline":"npm install",
    "startpackagepipeline":"vsce package --skip-license",
    "vscode:prepublish": "npm run compile",
    "precompile": "node utils/cleanOutput.cjs",
    "precompilefortest": "node utils/cleanOutput.cjs",
    "compile": "tsc -p tsconfig.json",
    "compilefortest":"tsc -p tsconfig.test.json",
    "postcompile": "node utils/copyPublicToOutput.cjs",
    "postcompilefortest":"node utils/copyPublicToOutput.cjs",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
