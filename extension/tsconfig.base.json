{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "rootDir": "src",
    "outDir": "out",
    "lib": ["es2022"],
    "types": ["node", "vscode"],
    "strict": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".vscode-test"]
}
